# Copy this file to .env and fill in the values. Do not commit .env.

# Password for the SQL Server "sa" login. Must be at least 8 characters with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=

# Signing key for access tokens. Must be the same for every service. Use 32+ random characters.
JWT_SIGNING_KEY=

# Optional. The account that becomes Admin on first start. Register this email in the app first.
BOOTSTRAP_ADMIN_EMAIL=
