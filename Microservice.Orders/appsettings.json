{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OrdersDb": "Server=(localdb)\\mssqllocaldb;Database=MiniCommerce.Orders;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Services": {
    "Cart": "http://localhost:60091",
    "Products": "http://localhost:60081"
  },
  "Messaging": {
    "Namespace": "mini-commerce.servicebus.windows.net",
    "QueueName": "mini-commerce"
  },
  "Stock": {
    "LowStockThreshold": 5
  },
  "Notifications": {
    "AdminEmail": ""
  },
  "Jwt": {
    "Issuer": "microservice.identity",
    "Audience": "commerce-api",
    "SigningKey": "REPLACE-WITH-A-32+-CHAR-DEV-KEY-OR-USER-SECRETS"
  }
}
